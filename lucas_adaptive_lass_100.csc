<?xml version="1.0" encoding="UTF-8"?>
<simconf>
  <project EXPORT="discard">[APPS_DIR]/mspsim</project>
  <project EXPORT="discard">[APPS_DIR]/serial_socket</project>
  <project EXPORT="discard">[APPS_DIR]/powertracker</project>
  <simulation>
    <title>Lucas Adaptive LASS 101 Motes (100 Clients + 1 Sink)</title>
    <randomseed>123456</randomseed>
    <motedelay_us>1000000</motedelay_us>
    <radiomedium>
      org.contikios.cooja.radiomediums.UDGM
      <transmitting_range>180.0</transmitting_range>
      <interference_range>360.0</interference_range>
      <success_ratio_tx>1.0</success_ratio_tx>
      <success_ratio_rx>1.0</success_ratio_rx>
    </radiomedium>
    <events>
      <logoutput>40000</logoutput>
    </events>
    <motetype>
      org.contikios.cooja.mspmote.SkyMoteType
      <identifier>sink</identifier>
      <description>RPL-UDP Server Sink</description>
      <source EXPORT="discard">[CONTIKI_DIR]/examples/joy29/lucas-adaptive-server.c</source>
      <commands EXPORT="discard">make TARGET=sky lucas-adaptive-server</commands>
      <firmware EXPORT="copy">[CONTIKI_DIR]/examples/joy29/build/sky/lucas-adaptive-server.sky</firmware>
